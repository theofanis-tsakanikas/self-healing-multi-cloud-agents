# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running the agent
#   cp .env.example .env
#
# DO NOT commit .env — it is listed in .gitignore.
# This file (.env.example) IS committed and serves as the canonical reference.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM backend the agents use. Options: openai | anthropic | vertexai
# Install the matching optional extra first:
#   openai    → already included in core deps (langchain-openai)
#   anthropic → uv sync --extra anthropic
#   vertexai  → uv sync --extra vertexai
LLM_PROVIDER=openai

# Maximum seconds to wait for a single LLM call (default: 120)
LLM_TIMEOUT_SEC=120

# Number of automatic retries on transient LLM errors (default: 1)
LLM_MAX_RETRIES=1

# THE model the agents use — this single var selects the chat model for EVERY provider (the provider
# is inferred from the prefix: gpt-*→openai, claude-*→anthropic, gemini-*→vertexai). The per-provider
# *_MODEL entries below are NOT read by the code; LLM_MODEL is the one that matters.
LLM_MODEL=gpt-4o


# ── OpenAI  (LLM_PROVIDER=openai) ────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...your-openai-key...

# Chat model ID (default: gpt-4o). See https://platform.openai.com/docs/models
# Common values: gpt-4o | gpt-4o-mini | gpt-4-turbo | o1 | o3-mini
# OPENAI_MODEL=gpt-4o


# ── Anthropic  (LLM_PROVIDER=anthropic) ──────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...your-anthropic-key...

# Chat model ID (default: claude-sonnet-4-20250514). See https://docs.anthropic.com/en/docs/about-claude/models
# Common values: claude-sonnet-4-20250514 | claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022 | claude-3-opus-20240229
# ANTHROPIC_MODEL=claude-sonnet-4-20250514


# ── Google Vertex AI  (LLM_PROVIDER=vertexai) ────────────────────────────────
# Point to a service-account JSON that has the Vertex AI User role
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Chat model ID (default: gemini-2.0-flash). See https://cloud.google.com/vertex-ai/generative-ai/docs/learn/models
# Common values: gemini-2.0-flash | gemini-2.0-flash-lite | gemini-1.5-pro | gemini-1.5-flash
# VERTEXAI_MODEL=gemini-2.0-flash


# ── Vector Store — Pinecone ───────────────────────────────────────────────────
# Create a free index at https://app.pinecone.io
# Index must use dimension=1536 (text-embedding-3-small) and cosine metric
PINECONE_API_KEY=pcsk_...your-pinecone-key...
PINECONE_INDEX_NAME=unified-intelligence-fabric


# ── GitHub — CI/CD integration ────────────────────────────────────────────────
# Personal access token with repo + workflow scopes
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...your-github-token...

# Accepted alternative name (same token, whichever you prefer)
# GH_TOKEN=ghp_...your-github-token...

# Repository the agent pushes generated artefacts to (owner/repo format)
# GitHub Actions sets this automatically; set it manually for local runs
GITHUB_REPOSITORY=your-org/your-repo

# Maximum characters fetched from GitHub Actions logs (default: 200000)
# GITHUB_FETCH_LOGS_MAX_CHARS=200000


# ── PostgreSQL — AWS RDS  (eu_sales pipeline) ─────────────────────────────────
# Outputs from `make bootstrap-aws` (see bootstrap/aws/outputs.tf)
POSTGRES_DB_HOST=your-rds-endpoint.rds.amazonaws.com
POSTGRES_DB_PORT=5432
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=...your-rds-password...
POSTGRES_DB_NAME=sales_raw


# ── MySQL — GCP Cloud SQL  (global_marketing pipeline) ───────────────────────
# Outputs from `make bootstrap-gcp`
MYSQL_DB_HOST=your-cloud-sql-public-ip
MYSQL_DB_PORT=3306
MYSQL_DB_USER=pipeline_user
MYSQL_DB_PASSWORD=...your-mysql-password...
MYSQL_DB_NAME=marketing_raw


# ── SQLite — local development only ──────────────────────────────────────────
# Use this to run the agent locally without a live cloud database
# SQLITE_SALES_URL=sqlite:///./data/sales_local.db


# ── Azure PostgreSQL — us_crm pipeline (source DB creds; Azure has no SSM) ────
# The us_crm pipeline resolves DB creds from these CRM_DB_* env vars via cloud_get.
CRM_DB_HOST=your-pg.postgres.database.azure.com
CRM_DB_PORT=5432
CRM_DB_USER=postgres
CRM_DB_NAME=crm_raw
CRM_DB_PASSWORD=...your-azure-db-password...


# ── Databricks — sales_lakehouse pipeline ────────────────────────────────────
DATABRICKS_HOST=https://dbc-xxxx.cloud.databricks.com
DATABRICKS_CLIENT_ID=...service-principal-app-id...
DATABRICKS_CLIENT_SECRET=...service-principal-oauth-secret...
# DATABRICKS_TOKEN=...only for the workspace-level destroy phase...


# ── GCP runtime project id — global_marketing pipeline ───────────────────────
# The value the pipeline's cloud_get reads (distinct from the bootstrap creds below).
GCP_PROJECT_ID=your-gcp-project-id


# ── LangSmith tracing (optional but recommended — the agent's own run trace) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=multi-cloud-self-healing-agent
# LANGCHAIN_API_KEY=ls-...your-langsmith-key...


# ── Trino — query engine ──────────────────────────────────────────────────────
# Trino runs inside the K8s cluster; use kubectl port-forward for local access:
#   kubectl port-forward svc/trino 8080:8080 -n analytics
TRINO_HOST=trino.analytics.svc.cluster.local
TRINO_PORT=8080
TRINO_USER=streamlit


# ── Prometheus — observability ────────────────────────────────────────────────
# Prometheus runs inside the K8s cluster; use kubectl port-forward for local access:
#   kubectl port-forward svc/prometheus 9090:9090 -n monitoring
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090


# ── AWS — Terraform bootstrap  (make bootstrap-aws) ──────────────────────────
# IAM user credentials for Terraform. Needs: AmazonEKSClusterPolicy,
# AmazonRDSFullAccess, AmazonS3FullAccess, AmazonEC2FullAccess, IAMFullAccess
AWS_ACCESS_KEY_ID=AKIA...your-aws-key-id...
AWS_SECRET_ACCESS_KEY=...your-aws-secret-key...
AWS_DEFAULT_REGION=eu-central-1

# Terraform variables for bootstrap/aws — sensitive values only
# (non-sensitive variables have defaults in bootstrap/aws/variables.tf)
TF_VAR_rds_password=...your-rds-master-password...
TF_VAR_rds_allowed_cidrs='["your.ip.address/32"]'
# ARN of the IAM user/role the GitHub Actions pipeline runs as
TF_VAR_pipeline_iam_arn=arn:aws:iam::123456789012:user/your-pipeline-user


# ── Azure — Terraform bootstrap  (make bootstrap-azure) ──────────────────────
# Service principal credentials for Terraform
# az ad sp create-for-rbac --role Contributor --name "multi-cloud-agent-sp"
ARM_CLIENT_ID=...azure-client-id...
ARM_CLIENT_SECRET=...azure-client-secret...
ARM_SUBSCRIPTION_ID=...azure-subscription-id...
ARM_TENANT_ID=...azure-tenant-id...

# Terraform variables for bootstrap/azure — sensitive values only
TF_VAR_subscription_id=...azure-subscription-id...
TF_VAR_db_password=...your-azure-pg-password...
# Object ID of the GitHub Actions service principal (az ad sp show --id <client-id>)
# TF_VAR_pipeline_object_id=...azure-object-id...


# ── GCP — Terraform bootstrap  (make bootstrap-gcp) ──────────────────────────
# GOOGLE_APPLICATION_CREDENTIALS is shared with the Vertex AI section above.
# The service account needs: Editor + roles/iam.workloadIdentityPoolAdmin

# Terraform variables for bootstrap/gcp — sensitive values only
TF_VAR_project_id=your-gcp-project-id
TF_VAR_db_password=...your-cloud-sql-password...
# GitHub repo for Workload Identity Federation (owner/repo format)
# TF_VAR_pipeline_github_repo=your-org/your-repo
