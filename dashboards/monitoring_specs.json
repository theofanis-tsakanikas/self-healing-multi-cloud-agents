{
  "uid": "pipe_crm_us_to_azure-dashboard",
  "title": "US CRM to Azure Data Observability",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["data-pipeline", "us-crm", "azure"],
  "panels": [
    {
      "id": 1,
      "title": "Record Count",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pipeline_rows_processed_total{project_id=\"us-crm\"}",
          "legendFormat": "Rows Processed"
        }
      ]
    },
    {
      "id": 2,
      "title": "Freshness",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pipeline_last_success_timestamp{project_id=\"us-crm\"}",
          "legendFormat": "Last Success"
        }
      ]
    },
    {
      "id": 3,
      "title": "Rejection Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pipeline_rows_rejected_total{project_id=\"us-crm\"} / clamp_min(pipeline_rows_processed_total{project_id=\"us-crm\"} + pipeline_rows_rejected_total{project_id=\"us-crm\"}, 1) * 100",
          "legendFormat": "Rejection Rate"
        }
      ]
    },
    {
      "id": 4,
      "title": "Run Duration",
      "type": "gauge",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{project_id=\"us-crm\"}",
          "legendFormat": "Duration"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rejections by Reason",
      "type": "piechart",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "pipeline_rows_rejected_by_reason{project_id=\"us-crm\"}",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ],
  "alerting": {
    "name": "US CRM — Data Silence Alert",
    "condition": "no data for 60 minutes",
    "severity": "critical",
    "for": "60m",
    "labels": { "severity": "critical", "project_id": "us-crm" },
    "annotations": { "summary": "No data received for US CRM pipeline in the last 60 minutes." }
  }
}